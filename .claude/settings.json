{
  "permissions": {
    "ask": [
      "Bash(git push:*)",
      "Bash(git push)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "pwsh -NoProfile -File .claude/statusline-command.ps1"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File .claude/hooks/shunt.ps1",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File .claude/hooks/session-end.ps1",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
