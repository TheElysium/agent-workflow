{
  "$schema": "https://opencode.ai/config.json",
  "small_model": "opencode/mimo-v2.5-free",
  "plugin": [
    "opencode-telemetry"
  ],
  "compaction": {
    "auto": true,
    "prune": true
  },
  "provider": {
    "opencode-go": {
      "models": {
        "glm-5.3-flash": {
          "limit": {
            "context": 120000,
            "output": 8192
          }
        }
      }
    }
  }
}
